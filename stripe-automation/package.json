{
  "name": "awgenesis-stripe-automation",
  "version": "1.0.0",
  "description": "AWGenesis Stripe Automation — backend de facturación híbrida",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "stripe:create-products": "node scripts/create-stripe-products.js",
    "stripe:create-products:dry": "node scripts/create-stripe-products.js --dry-run",
    "stripe:create-products:write": "node scripts/create-stripe-products.js --write",
    "stripe:create-payment-links": "node scripts/create-stripe-payment-links.js",
    "stripe:create-payment-links:dry": "node scripts/create-stripe-payment-links.js --dry-run",

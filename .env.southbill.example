# Server-only. Store actual values in ignored .env.local or PulseAW's Vercel project.
# Observe/reconcile only. Enabling this receiver never enables invoice creation.
SOUTHBILL_ENABLED=false
SOUTHBILL_MODE=live
SOUTHBILL_MERCHANT_ID=
SOUTHBILL_API_KEY=
SOUTHBILL_WEBHOOK_SECRET=
SOUTHBILL_WEBHOOK_SECRET_PREVIOUS=
SOUTHBILL_DATABASE_URL=
# Official database CA PEM; escaped newlines are supported.
SOUTHBILL_DATABASE_CA=
SOUTHBILL_WORKER_TOKEN=

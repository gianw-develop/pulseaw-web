# Server-only. Store actual values in ignored .env.local or PulseAW's Vercel project.
# Observe/reconcile only. Enabling this receiver never enables invoice creation.
SOUTHBILL_ENABLED=false
SOUTHBILL_MODE=live
# Optional: only fill if SouthBill provides an officially verified merchant ID.
# Not required by documented Merchant API authentication or webhook signatures.
# PulseAW's private ledger namespace is assigned internally by this application.
SOUTHBILL_MERCHANT_ID=
SOUTHBILL_API_KEY=
SOUTHBILL_WEBHOOK_SECRET=
SOUTHBILL_WEBHOOK_SECRET_PREVIOUS=
SOUTHBILL_DATABASE_URL=
# Official database CA PEM; escaped newlines are supported.
SOUTHBILL_DATABASE_CA=
SOUTHBILL_WORKER_TOKEN=

# Owner-authorized bookkeeping; never enables a charge or an invoice send.
SOUTHBILL_INVOICE_MODE=disabled

# Private approved catalog registry. Never use NEXT_PUBLIC_ or commit actual entries.
# See docs/southbill/private-catalog.md. Empty keeps private allocation unavailable.
SOUTHBILL_INTERNAL_CATALOG_JSON=
